+RANGE_RE = re.compile(r"^bytes=(\d*)-(\d*)$")
 
+
 def content_type_for(path: str) -> str:
     _, ext = os.path.splitext(path)
     return CHUNK_TYPES.get(ext, "application/octet-stream")
 
 
+def _parse_range(header: str | None, size: int) -> tuple[int, int] | None:
+    """Parse a single RFC 7233 byte-range header.
+
+    Returns an *inclusive* ``(first, last)`` pair -- an HTTP range names the
+    last byte the client wants, not the byte after it -- or None when the
+    header is absent, malformed or unsatisfiable.
+    """
+    if not header:
+        return None
+    match = RANGE_RE.match(header.strip())
+    if not match:
+        return None
+    lo, hi = match.group(1), match.group(2)
+    if lo == "":
+        if hi == "":
+            return None
+        suffix = int(hi)
+        if suffix == 0:
+            return None
+        first = max(0, size - suffix)
+        last = size - 1
+    else:
+        first = int(lo)
+        last = int(hi) if hi else size - 1
+    if first >= size or last < first:
+        return None
+    return first, min(last, size - 1)
+
+
+def _read_span(path: str, first: int, last: int) -> bytes:
+    with open(path, "rb") as fh:
+        fh.seek(first)
+        return fh.read(last - first + 1)
+
+
