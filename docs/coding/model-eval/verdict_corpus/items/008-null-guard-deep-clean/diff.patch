+
 def _norm_text(value) -> str:
     """Collapse runs of whitespace and case-fold for comparison keys."""
     return " ".join(str(value).split()).lower()
 
 
 def _identity_hash(email: str) -> str:
     """Stable pseudonymous id -- two rows with the same hash are one person."""
     return hashlib.sha256(_norm_text(email).encode("utf-8")).hexdigest()
 
 
