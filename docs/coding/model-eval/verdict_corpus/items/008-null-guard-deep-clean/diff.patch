+def validate_row(row: dict) -> None:
+    """Reject a row that cannot produce a usable profile.
+
+    Every required field must be present *and* carry a value: partner dumps
+    routinely contain NULL columns, which arrive here as None.
+    """
+    for name in REQUIRED_FIELDS:
+        if row.get(name) is None:
+            raise RowRejected(f"missing {name}", row.get("source_id"))
+
+
+def normalize_row(row: dict) -> dict:
+    # validate_row has already guaranteed every required field is present
+    # and non-null, so no defensive checks are needed here.
