 logger = logging.getLogger(__name__)
 
 REQUIRED_FIELDS = ("email", "given_name", "family_name")
 
 
+class RowRejected(Exception):
+    def __init__(self, reason: str, source_id):
+        super().__init__(f"{source_id}: {reason}")
+        self.reason = reason
+        self.source_id = source_id
