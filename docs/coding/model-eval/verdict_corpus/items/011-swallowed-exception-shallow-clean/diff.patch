+            # Deliberately broad: this runs on the exporter's own thread, and
+            # every sink in the fleet raises its own driver-specific error
+            # type.  The batch is dropped rather than retried so the buffer
+            # stays bounded -- but the drop is counted and recorded, because
+            # the one thing a metrics pipeline must never do is fail
+            # invisibly.
+            self.dropped += len(batch)
+            self.last_error = repr(exc)
+            logger.error(
