+def probe(path: str) -> dict | None:
+    """Peek at a segment header without reading its records.
+
+    The compactor calls this once per candidate file -- thousands per run --
+    to decide which segments a generation actually needs to touch.  Returns
+    None for anything that is not a readable EVS2 segment: foreign files and
+    half-written segments from a crashed writer are both expected here.
+    """
+    fh = open(path, "rb")
+    try:
+        if fh.read(4) != MAGIC:
+            return None
+        raw = fh.read(HEADER_LEN)
+        if len(raw) < HEADER_LEN:
+            return None
+        return _decode_header(raw)
+    finally:
+        # Explicit close rather than a `with` block: the compactor's C shim
+        # calls probe() through a wrapper that hands back the file object on
+        # success, so the close has to stay in one place we control.
+        fh.close()
+
