 class HandlerNotFound(Exception):
     """Raised when no handler is registered for a message kind."""
 
 
+class Attempts:
+    """Per-message delivery accounting.
+
+    ``record`` is called on every failure that puts a message back on the
+    queue, and its return value is what decides whether the message is still
+    worth redelivering.  A message that is never recorded is, by
+    construction, never poisoned -- it will be redelivered without limit.
+    """
+
+    def __init__(self, max_attempts: int = 5):
+        self._max = max_attempts
+        self._counts: dict[str, int] = {}
+
+    def record(self, message_id: str) -> bool:
+        count = self._counts.get(message_id, 0) + 1
+        self._counts[message_id] = count
+        return count < self._max
+
+    def clear(self, message_id: str) -> None:
+        self._counts.pop(message_id, None)
+
+
 class Worker:
-    def __init__(self, broker, handlers, poll_timeout: float = 1.0):
+    def __init__(self, broker, handlers, poll_timeout: float = 1.0, max_attempts: int = 5):
         self._broker = broker
         self._handlers = dict(handlers)
         self._poll_timeout = poll_timeout
+        self._attempts = Attempts(max_attempts)
 
     def _handle(self, message) -> None:
         handler = self._handlers.get(message.kind)
         if handler is None:
             raise HandlerNotFound(message.kind)
         handler(message.payload)
 
+    def _retry_or_retire(self, message) -> None:
